{
  "name": "@hualiong/dsh-session-delete",
  "version": "0.3.3",
  "description": "Delete sessions of a DeepSeek Harness profile from the UI: session-row menu item with a confirm dialog; the host endpoint (user-driven only) deletes the log, projection cache and workspace accounting. Works in web and the desktop client alike.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["dsh-plugin", "deepseek-harness", "cordis", "session-management"],
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hualiong/dsh-session-delete.git"
  },
  "homepage": "https://github.com/hualiong/dsh-session-delete#readme",
  "bugs": {
    "url": "https://github.com/hualiong/dsh-session-delete/issues"
  },
  "author": "hualiong",
  "files": [
    "src/",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  }
}
